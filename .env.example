# Caminho da biblioteca nativa, não do fluidsynth.exe.
# Use barras / no Windows. Preserve as outras DLLs na mesma pasta.
FLUIDSYNTH_DLL="C:/caminho/fluidsynth/bin/libfluidsynth-3.dll"

# Entrada analógica -> nota MIDI. Vazio desabilita o som da entrada.
# O firmware precisa enviar HIT com o ID da entrada: 0 = A0, 1 = A1, etc.
DRUM_A0=38 # Caixa acústica
DRUM_A1=36 # Bumbo
DRUM_A2=42 # Chimbal fechado
DRUM_A3=46 # Chimbal aberto
DRUM_A4=45 # Tom grave
DRUM_A5=48 # Tom médio-agudo
DRUM_A6=49 # Prato de ataque (crash)
DRUM_A7=51 # Prato de condução (ride)
